# Copy this file to .env and fill in your values. Never commit .env.

# Gnani API key from app.gnani.ai/voice -> API Keys
GNANI_API_KEY=

# Evon server URL and key printed by notebooks/evon_kaggle.ipynb (leave empty to use the fallback)
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=evon

# Optional overrides
# STT_LANGUAGES=hi-IN,en-IN
# TTS_VOICE_OWNER=Shivani
# TTS_VOICE_TECH=Avinash
# MAX_RUNS_PER_SESSION=5
# MAX_RUNS_PER_DAY=400
# DEMO_MODE=false

# Public link of the deployed app (used inside QR stickers)
# APP_URL=https://your-app.streamlit.app
# Measured STT cost per minute, once you have a real row on the Gnani usage page
# STT_CREDITS_PER_MIN=0.5
